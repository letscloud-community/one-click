# Cache objects
packer_cache/

# Crash log
crash.log

# https://www.packer.io/guides/hcl/variables
# Exclude all .pkrvars.hcl files, which are likely to contain sensitive data, 
# such as password, private keys, and other secrets. These should not be part of 
# version control as they are data points which are potentially sensitive and 
# subject to change depending on the environment.
#
*.pkrvars.hcl

# For built boxes
*.box

# Runtime artefacts that must never be committed. The per-instance .env holds
# the generated server and admin passwords; env.example is the template and is
# tracked on purpose.
**/.env
!**/env.example
**/backups/
packer-build.log

# Token da API, nunca versionar
.letscloud_token
**/.letscloud_token

# Scratch files que ja foram usados para guardar token em texto puro
hermes-26-04/test
