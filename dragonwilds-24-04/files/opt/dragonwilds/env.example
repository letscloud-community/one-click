# RuneScape: Dragonwilds dedicated server configuration.
#
# This file is a TEMPLATE. The live configuration is /opt/dragonwilds/.env,
# which is generated on the first boot by scripts/first-boot.sh with unique
# random passwords, and is chmod 600 root:root.
#
# The container regenerates DedicatedServer.ini from these variables on every
# start, so this file is the single source of truth. Editing the .ini inside
# data/ has no lasting effect.
#
# After changing anything here run: /opt/dragonwilds/scripts/restart.sh

# --- Mandatory ---------------------------------------------------------------

# Your EOS Online ID, found in-game at the bottom of the Settings menu (there
# is a copy button next to it). The server will not start without it.
RSDW_OWNER_ID=

# --- Identity ----------------------------------------------------------------

# Shown in the "Created By" column of the server browser.
# Limited to 16 characters, see the note below.
RSDW_SERVER_NAME=letscloud-dw

# The name players search for in Worlds > Public. Exact match, case sensitive.
#
# IMPORTANT: keep it to 16 characters or fewer. The game publishes the world
# name to the Worlds browser as an EOS session attribute capped at 16, and
# silently truncates anything longer ("SlotName truncated to fit max length" in
# the server log) while the local save keeps the full name. Players given the
# full name would then search for a string the browser never returns.
RSDW_WORLD_NAME=

# UDP game port. Fixed at 7777 for this image, which runs a single server per
# VPS. Do not change it: the value is mirrored in the UFW rule and in the
# address shown to players, and editing it here alone would leave the firewall
# closed.
RSDW_PORT=7777

# UDP beacon port, which the Worlds browser uses to advertise and reach the
# server. It is mandatory: with the beacon port closed the world still shows up
# in the list and then fails to join with "connection lost". The convention is
# game port + 1111, so 8888 for the default 7777.
RSDW_BEACON_PORT=8888

# --- Access control ----------------------------------------------------------

# World password. Leave empty for an open server.
# Never set this to the literal string "random": the image would regenerate it
# on every container start and lock your players out.
RSDW_PASSWORD=

# Grants access to Pause Menu > Settings > Server Management.
RSDW_ADMIN_PASSWORD=

# Comma separated list of EOS Online IDs with permanent admin rights.
RSDW_ADMINS=

# --- Updates -----------------------------------------------------------------

# Container image tag. "latest" tracks the official image; pin to a release
# such as 1.1.1 if you want to control container updates yourself.
DW_IMAGE_TAG=latest

# When true the container exits as soon as Steam advertises a new build, and
# the restart policy brings it back updated. That kicks connected players, so
# it stays false and dragonwilds-update.timer handles updates instead.
RSDW_AUTO_STOP_ON_UPDATE=false

# How the update timer behaves when a new Steam build is detected:
#   notify    only write to the log, never restart (fully manual)
#   window    restart inside DW_UPDATE_WINDOW_HOUR, and only if idle (default)
#   immediate restart as soon as the server is idle, at any hour
DW_UPDATE_MODE=window

# Hour of the day (0-23, server local time) used by the "window" mode.
DW_UPDATE_WINDOW_HOUR=5

# Skip the restart while players are connected. Strongly recommended.
DW_UPDATE_REQUIRE_IDLE=true

# Valve does not publish version info for every dedicated server tool, so the
# update check can be unable to tell whether a new build exists. When that
# happens the fallback performs a periodic maintenance restart and lets
# SteamCMD decide, which is a no-op when the server is already current.
# It still honours the maintenance window and the idle check.
DW_UPDATE_FALLBACK=true

# Minimum number of days between fallback maintenance restarts.
DW_UPDATE_FALLBACK_DAYS=1

# --- Backups -----------------------------------------------------------------

# How many archives to keep per tier.
DW_KEEP_HOURLY=24
DW_KEEP_DAILY=7
DW_KEEP_WEEKLY=4

# Stop the container before every scheduled backup. Guarantees a consistent
# save at the cost of a short outage each hour. The default (false) takes a
# hot copy and only snapshots .sav files that are not being written to.
DW_BACKUP_COLD=false

# --- Advanced ----------------------------------------------------------------

# Extra CLI arguments appended to RSDragonwildsServer.sh.
# Do not pass -FORCELOGFLUSH: the official image warns that it fdatasyncs the
# log file on the game thread after every line, which can freeze the server for
# seconds during log bursts. RSDW_LINE_BUFFERED_LOGS already makes logs appear
# immediately without that cost.
RSDW_ADDITIONAL_ARGS=

# Line-buffer the server stdout so each line reaches the container log right
# away. Leave as true unless you are chasing a buffering issue.
RSDW_LINE_BUFFERED_LOGS=true

# Set to 1 to make SteamCMD verify and repair game files on the next start.
STEAMAPPVALIDATE=0

# Container log verbosity: 0 none, 1 steamcmd, 2 rsdw, 3 all.
DEBUG=0
